# Database connection string (PostgreSQL + pgvector)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/trustlayer

# Gemini API key for claim extraction
GEMINI_API_KEY=

# Hugging Face token for model downloads (BGE-M3, DeBERTa-v3)
HF_TOKEN=

# HuggingFace model cache directory (defaults to ~/.cache/huggingface if empty)
HF_HOME=./models_cache